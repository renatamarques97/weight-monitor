<div data-workout-form-target="weightliftingFields" class="md:col-span-2 grid gap-4 md:grid-cols-2" style="display: none;">
  <div>
    <%= form.label "details[exercises_count]", t('workout.details.exercises_count'), class: "tw-label" %>
    <%= form.number_field "details[exercises_count]", step: 1, class: "tw-input", value: (form.object.respond_to?(:details) && form.object.details.respond_to?(:exercises_count)) ? form.object.details.exercises_count : nil %>
  </div>
  <div class="grid gap-4 grid-cols-2">
    <div>
      <%= form.label "details[volume]", t('workout.details.volume', unit: form.object.weight_unit), class: "tw-label", data: unit_label_data('weight', 'workout.details.volume') %>
      <%= form.number_field "details[volume]", step: :any, class: "tw-input",
            value: (form.object.respond_to?(:details) && form.object.details.respond_to?(:volume)) ? form.object.details.volume : nil %>
    </div>

    <div>
      <%= form.label :weight_unit, t('unit'), class: "tw-label" %>
      <%= form.select :weight_unit, unit_options(MeasurementUnits::WEIGHTS::ALL), {}, class: "tw-input", data: unit_select_data('weight') %>
    </div>
  </div>
</div>
