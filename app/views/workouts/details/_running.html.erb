<div data-workout-form-target="runningFields" style="display: none;">
  <%= form.label "details[avg_pace]", t('workout.details.avg_pace', unit: form.object.persisted? ? form.object.distance_unit : current_user.distance_unit), class: "tw-label" %>
  <%= form.number_field "details[avg_pace]", step: :any, class: "tw-input", readonly: true, disabled: true,
        value: (form.object.respond_to?(:details) && form.object.details.respond_to?(:avg_pace)) ? form.object.details.avg_pace : nil %>
</div>
