<%= render "dashboard/menu" %>

<section class="mx-auto max-w-xl rounded-2xl border fit-border-subtle fit-surface-card p-6 shadow-sm">
  <h1 class="mb-4 text-2xl font-bold tracking-tight fit-text-primary"><%= t('sign.up') %></h1>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), data: { turbo: false }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="mb-3">
      <%= f.label :name, class: "tw-label" %>
      <%= f.text_field :name, class: "tw-input" %>
    </div>

    <div data-controller="height-converter"
         data-height-converter-placeholder-ft-value="<%= height_placeholder(HEIGHTS::FT) %>"
         data-height-converter-placeholder-cm-value="<%= height_placeholder(HEIGHTS::CM) %>"
         data-height-converter-placeholder-m-value="<%= height_placeholder(HEIGHTS::M) %>">
      <div class="mb-3">
        <%= f.label :height, t('diet.height', unit: '').gsub(/\s*\(.*?\)/, ''), class: "tw-label", data: { height_converter_target: "label" } %>
        <%= f.text_field :height, class: "tw-input", placeholder: height_placeholder(resource.height_unit.presence || HEIGHTS::M), data: { height_converter_target: "input" } %>
      </div>

      <div class="mb-2 text-xs fit-text-secondary">
        <%= t('preferences.new_info') %>
      </div>

      <div class="mb-3 grid grid-cols-3 gap-3">
        <div>
          <%= f.label :weight_unit, t('preferences.weight_unit'), class: "tw-label" %>
          <%= f.select :weight_unit, WEIGHTS::ALL.map { |unit| [t("units.#{unit}"), unit] }, { selected: resource.weight_unit.presence || MeasurementUnits::WEIGHTS::KG }, class: "tw-input" %>
        </div>
        <div>
          <%= f.label :distance_unit, t('preferences.distance_unit'), class: "tw-label" %>
          <%= f.select :distance_unit, DISTANCES::ALL.map { |unit| [t("units.#{unit}"), unit] }, { selected: resource.distance_unit.presence || MeasurementUnits::DISTANCES::KM }, class: "tw-input" %>
        </div>
        <div>
          <%= f.label :height_unit, t('preferences.height_unit'), class: "tw-label" %>
          <%= f.select :height_unit, HEIGHTS::ALL.map { |unit| [t("units.#{unit}"), unit] }, { selected: resource.height_unit.presence || MeasurementUnits::HEIGHTS::M }, class: "tw-input", data: { height_converter_target: "select", action: "change->height-converter#convert" } %>
        </div>
      </div>
    </div>

    <div class="mb-3">
      <%= f.label :email, class: "tw-label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "tw-input" %>
    </div>

    <div class="mb-3">
      <%= f.label :password, class: "tw-label" %>
      <% if @minimum_password_length %>
        <small class="mt-1 block text-xs fit-text-secondary">(<%= @minimum_password_length %> characters minimum)</small>
      <% end %>
      <%= f.password_field :password, autocomplete: "new-password", class: "tw-input" %>
    </div>

    <div class="mb-3">
      <%= f.label :password_confirmation, class: "tw-label" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "tw-input" %>
    </div>

    <div class="mb-3">
      <%= f.submit t('sign.up'), class: 'tw-btn-primary w-full' %>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>
</section>
