<%= form_with(model: weight, local: true) do |form| %>
  <% if weight.errors.any? %>
  <div id="error_explanation" class="fit-form-error">
      <h2><%= pluralize(weight.errors.count, t('error.single')) %> <%= t('error.saved') %></h2>
      <ul>
        <% weight.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <section class="tw-card" data-controller="unit-label">
    <div class="grid gap-4 md:grid-cols-3">
      <div>
        <%= form.label :value, t('weight.value_label', unit: weight.weight_unit), class: "tw-label", data: unit_label_data('weight', 'weight.value_label') %>
        <%= form.number_field :value, step: :any, class: "tw-input" %>
      </div>

      <div>
        <%= form.label :weight_unit, t('unit'), class: "tw-label" %>
        <%= form.select :weight_unit, unit_options(MeasurementUnits::WEIGHTS::ALL), {}, class: "tw-input", data: unit_select_data('weight') %>
      </div>

      <div>
        <%= form.label :weight_date, class: "tw-label" %>
        <%= form.date_field :weight_date, class: "tw-input" %>
      </div>
    </div>

    <div class="mt-5 flex gap-3">
      <%= form.submit class: 'tw-btn-primary' %>
      <%= link_to t('back'), weights_path, class: 'tw-btn-secondary' %>
    </div>
  </section>
<% end %>
