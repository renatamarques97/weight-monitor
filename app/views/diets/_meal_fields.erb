<div class="mb-3 rounded-xl border fit-border-subtle fit-surface-muted p-4" data-nested-form-wrapper>
  <%= f.hidden_field :id if f.object.persisted? %>
  <%= f.hidden_field :_destroy, value: "0" %>

  <div class="grid gap-3 md:grid-cols-[1fr_2fr_1fr_2fr_1fr_auto] md:items-end">
        <div class="relative">
          <%= f.label :food_name, t('meal.food_name'), class: 'tw-label' %>
          <%= f.text_field :food_name,
                           class: 'tw-input fatsecret-autocomplete',
                           placeholder: t('meal.search_food_placeholder'),
                           autocomplete: 'off' %>
          <%= f.hidden_field :fatsecret_food_id %>
        </div>
        <div>
          <%= f.label :calories, t('meal.calories'), class: 'tw-label' %>
          <%= f.number_field :calories, step: :any, class: 'tw-input', readonly: true %>
          <%= f.label :protein, t('meal.protein'), class: 'tw-label mt-1' %>
          <%= f.number_field :protein, step: :any, class: 'tw-input', readonly: true %>
          <%= f.label :carbs, t('meal.carbs'), class: 'tw-label mt-1' %>
          <%= f.number_field :carbs, step: :any, class: 'tw-input', readonly: true %>
          <%= f.label :fat, t('meal.fat'), class: 'tw-label mt-1' %>
          <%= f.number_field :fat, step: :any, class: 'tw-input', readonly: true %>
          <%= f.label :metric_serving_unit, t('meal.metric_serving_unit'), class: 'tw-label mt-1' %>
          <%= f.text_field :metric_serving_unit, class: 'tw-input', readonly: true %>
        </div>
    <div>
      <%= f.label :schedule, class: "tw-label" %>
      <%= f.time_field :schedule, class: "tw-input" %>
    </div>

    <div>
      <%= f.label :description, class: "tw-label" %>
      <%= f.text_field :description, class: "tw-input" %>
    </div>

    <div>
      <%= f.label :meal_type, class: "tw-label" %>
      <%= f.select :meal_type, Meal.meal_type.options, {}, class: "tw-input" %>
    </div>

    <div class="flex items-end">
      <button type="button" class="fit-icon-btn fit-icon-btn-delete" data-action="nested-form#remove" title="<%= t('meal.remove') %>" aria-label="<%= t('meal.remove') %>">
        <i class="fa fa-trash" aria-hidden="true"></i>
      </button>
    </div>
  </div>
</div>

