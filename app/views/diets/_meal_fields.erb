<div class="mb-3 rounded-xl border fit-border-subtle fit-surface-muted p-4" data-nested-form-wrapper>
  <%= f.hidden_field :id if f.object.persisted? %>
  <%= f.hidden_field :_destroy, value: "0" %>

  <div class="grid gap-3 md:grid-cols-[1fr_2fr_1fr_auto] md:items-end">
    <div>
      <%= f.label :schedule, class: "tw-label" %>
      <%= f.time_field :schedule, class: "tw-input" %>
    </div>

    <div>
      <%= f.label :description, class: "tw-label" %>
      <%= f.text_field :description, class: "tw-input" %>
    </div>

    <div>
      <%= f.label :meal_type, class: "tw-label" %>
      <%= f.select :meal_type, Meal.meal_type.options, {}, class: "tw-input" %>
    </div>

    <div class="flex items-end">
      <button type="button" class="fit-icon-btn fit-icon-btn-delete" data-action="nested-form#remove" title="<%= t('meal.remove') %>" aria-label="<%= t('meal.remove') %>">
        <i class="fa fa-trash" aria-hidden="true"></i>
      </button>
    </div>
  </div>

  <div class="mt-4 rounded-lg border fit-border-subtle fit-surface-muted p-3" data-controller="nested-form" data-nested-form-token-value="NEW_FOOD_RECORD">
    <div class="mb-3 flex items-center justify-between gap-3">
      <p class="text-sm font-semibold fit-text-primary"><%= t('meal.foods_title') %></p>
      <button type="button" class="tw-btn-primary tw-btn-food" data-action="nested-form#add">
        <i class="fa fa-plus mr-2" aria-hidden="true"></i><%= t('meal.add_food') %>
      </button>
    </div>

    <template data-nested-form-target="template">
      <%= f.fields_for :meal_foods, MealFood.new, child_index: 'NEW_FOOD_RECORD' do |food_fields| %>
        <%= render 'diets/meal_food_fields', f: food_fields %>
      <% end %>
    </template>

    <div data-nested-form-target="list">
      <%= f.fields_for :meal_foods do |food_fields| %>
        <%= render 'diets/meal_food_fields', f: food_fields %>
      <% end %>
    </div>
  </div>
</div>

