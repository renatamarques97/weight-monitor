<%= form_with(model: diet, local: true) do |form| %>
  <% if diet.errors.any? %>
    <div id="error_explanation" class="fit-form-error">
      <h2>
        <%= pluralize(diet.errors.count, t('error.single')) %>
        <%= t('error.saved') %>
      </h2>

      <ul>
        <% diet.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <section class="tw-card" data-controller="nested-form">
    <h2 class="mb-4 text-xl font-bold fit-text-primary"><%= t('diet.singular') %></h2>

    <div class="mb-5 rounded-xl border fit-border-subtle fit-surface-muted p-4">
      <div class="flex items-start gap-3">
        <i class="fa fa-circle-info mt-1 fit-text-primary" aria-hidden="true"></i>
        <div class="text-sm fit-text-primary">
          <p class="font-semibold"><%= t('diet.plan_banner.title') %></p>
          <p class="mt-1 fit-text-secondary">
            <%= t('diet.plan_banner.description') %>
          </p>
        </div>
      </div>
    </div>

    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
      <div class="xl:col-span-2">
        <%= form.label :start_date, class: "tw-label" %>
        <%= form.date_field :start_date, class: "tw-input" %>
      </div>

      <div class="xl:col-span-2">
        <%= form.label :end_date, class: "tw-label" %>
        <%= form.date_field :end_date, class: "tw-input" %>
      </div>

      <% diet_weight_unit_value = diet.persisted? ? diet.weight_unit : current_user.weight_unit %>
      <%= form.hidden_field :weight_unit, value: diet_weight_unit_value %>

      <div>
        <%= form.label :initial_weight, t('diet.initial_weight', unit: '').gsub(/\s*\(.*?\)/, ''), class: "tw-label" %>
        <%= form.number_field :initial_weight, step: :any, class: "tw-input", placeholder: weight_placeholder(diet_weight_unit_value) %>
      </div>

      <div>
        <%= form.label :target_weight, t('diet.target_weight', unit: '').gsub(/\s*\(.*?\)/, ''), class: "tw-label" %>
        <%= form.number_field :target_weight, step: :any, class: "tw-input", placeholder: weight_placeholder(diet_weight_unit_value) %>
      </div>
    </div>

    <div class="my-5 h-px fit-surface-border"></div>

    <div class="mb-3 flex items-center justify-between gap-3">
      <h3 class="text-lg font-semibold fit-text-primary"><%= t('meal.title') %></h3>
      <button type="button" class="tw-btn-primary" data-action="nested-form#add">
        <i class="fa fa-plus mr-2" aria-hidden="true"></i><%= t('meal.add') %>
      </button>
    </div>

    <template data-nested-form-target="template">
      <%= form.fields_for :meals, Meal.new, child_index: "NEW_RECORD" do |ff| %>
        <%= render 'meal_fields', f: ff %>
      <% end %>
    </template>

    <div data-nested-form-target="list">
      <%= form.fields_for :meals do |ff| %>
        <%= render 'meal_fields', f: ff %>
      <% end %>
    </div>

    <div class="mt-5 flex gap-3">
      <%= form.submit class: 'tw-btn-primary' %>
      <%= link_to t('back'), diets_path, class: 'tw-btn-secondary' %>
    </div>
  </section>
<% end %>
